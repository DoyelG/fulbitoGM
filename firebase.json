{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8181
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "functions": [
    {
      "source": "apps/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": ["pnpm --filter @fulbito/functions build"]
    },
    {
      "source": "functions",
      "codebase": "mail",
      "ignore": ["node_modules", "src", "tsconfig.json"],
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" install --ignore-workspace --frozen-lockfile",
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
